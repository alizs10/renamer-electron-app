{
  "name": "renamer-electron-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"bun run dev:react\" \"bun run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "bun run transpile:electron; cross-env NODE_ENV=development electron --trace-warnings .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:mac": "bun run transpile:electron && npm run build && electron-builder --mac --arm64",
    "dist:win": "bun run transpile:electron && npm run build && electron-builder --win --x64",
    "dist:linux": "bun run transpile:electron && npm run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "lucide-react": "^0.503.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.5",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.0.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1"
  }
}